# Copy to .env for local runs (.env is not version-controlled). See the Configuration table in README.md.
# The agent does not need Besu's address: the platform forwards each request to 127.0.0.1:<port> through the tunnel.
PLATFORM_ADDR=localhost:8443
AGENT_STATE_DIR=state

# Optional
# ALLOW_PORTS=8545,9545,30303   # restrict forwarding and probes to these ports; unset = all
# DISK_PATH=/                   # path used for disk usage
# LOG_SINK=127.0.0.1:5170       # address that receives Besu logs
# LOG_SPOOL_MAX=512MB           # log spool size limit
