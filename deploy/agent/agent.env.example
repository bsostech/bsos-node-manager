# Node Agent environment variables (for bare-metal systemd; copy to /etc/besu-agent/agent.env)
# The agent does not need to know where Besu is: the platform forwards through it to 127.0.0.1:<port>, and the port is a column in the platform's nodes table.
PLATFORM_ADDR=platform.example:8443
AGENT_STATE_DIR=/var/lib/besu-agent

# Optional
# ALLOW_PORTS=8545,9545   # restrict the platform's forwarding to these ports; unset = all of loopback open
#                         # an invalid value (not a 1-65535 port, or only commas) stops the agent from starting
# DISK_PATH=/             # the bare-metal default is fine; only a container sidecar needs /rootfs
# LOG_SINK=127.0.0.1:5170 # address that receives Besu logs; when Besu runs in a container on a bridge network, use the docker0 IP
