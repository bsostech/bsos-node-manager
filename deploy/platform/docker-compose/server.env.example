# Platform Server env (Docker Compose version). up.sh generates server.env from this file (filling in ORG_ID/CA_MASTER_KEY/SITE domain).
# DATABASE_URL and AGENT_BINARY_DIR are overridden by environment in docker-compose.yml (pointing at the postgres service / mounted directory); not set here.
# ACME_CACHE_DIR / SITE_CERT_FILE / SITE_KEY_FILE are likewise overridden by docker-compose.yml (pointing at mounted volumes/directories); not set here.

# ── Required ──
ORG_ID=org-a.example                          # written into every certificate's O, cannot change once the CA exists; lowercase alphanumerics and . - _, company domain recommended
CA_MASTER_KEY=__output-of-openssl-rand-hex-32__ # embedded CA master key. ⚠ One per org, never changed (changing it leaves the existing CA undecryptable)
# To keep the master key out of plaintext env (visible via docker inspect): delete the line above and store the same hex string in a file mounted as a docker secret,
#   CA_MASTER_KEY_FILE=/run/secrets/ca_master_key
#   (compose: add `secrets: [ca_master_key]` to the server service and top-level `secrets: { ca_master_key: { file: ./ca_master_key } }`;
#    the file must be readable by uid 10001 inside the container, e.g. chown 10001). Setting both refuses to start. cactl reads the same variables.
# RPC_KEY_BACKEND=db                            # where the node RPC token signing key is stored; Core has only db, Enterprise will offer other backends later
# BOOTSTRAP_ADMIN_PASSWORD=          # initial password of the default admin account on first start; up.sh fills in a random one. If unset, the server generates one and prints it in the log once. First login always forces a password change
# TZ=Asia/Taipei                    # optional: the platform host's IANA time zone, the default zone of alert notifications (UTC when unset). up.sh fills it from the host; an existing line is kept
# ── Temporary password email (optional) ── Admins can tick "Email the temporary password" when creating accounts or resetting passwords; if unset, the password is only shown on screen for the admin to pass on.
#   Separate from the alert notification SMTP; neither affects the other. Restart server after changes. Invalid settings stop the platform from starting; connection failures are only logged.
# ACCOUNT_SMTP_HOST=smtp.org-a.internal
# ACCOUNT_SMTP_PORT=587                 # default 25
# ACCOUNT_SMTP_FROM=bsos-node-manager@org-a.example   # required when HOST is set
# ACCOUNT_SMTP_USERNAME=                # optional: leave empty for internal relays without credentials
# ACCOUNT_SMTP_PASSWORD=                # or use ACCOUNT_SMTP_PASSWORD_FILE=/run/secrets/account_smtp_password (same approach as CA_MASTER_KEY_FILE); set only one of the two
# ACCOUNT_SMTP_SECURITY=                # tls / starttls / none. Unset = tls on port 465, starttls on other ports (including 25); if the upgrade fails the mail is not sent, never falling back to plaintext.
#                                       #   Unencrypted internal relays must set none explicitly; with none and a username, a server that lists AUTH PLAIN first is refused. Check what the server supports first:
#                                       #   openssl s_client -starttls smtp -connect host:587   (drop -starttls smtp for port 465)

# ── Internal CA for mail servers (alert mail and password mail) ──
# SMTP_CA_FILE=/certs/smtp-ca.pem       # optional: CA certificates (PEM, several allowed) for mail servers signed by an internal CA. Applies to STARTTLS/TLS
#                                       #   for both alert mail (copied next to alertmanager.yml for Alertmanager) and password mail. When set, ONLY the CAs
#                                       #   in this file are trusted, not the system store: also put the public CA in it if one of the servers uses a public certificate.
#                                       #   Unset uses the system trust store. Skipping certificate verification is not offered

# ── Listening (inside the container; publishing is decided by compose ports) ──
LISTEN_ADDR=:80                               # only meaningful when TLS_MODE=http (plain HTTP listen port, matching compose's 80:80); acme/manual always use 443 and ignore it
INTERNAL_ADDR=:8080                           # internal only (port not published): only for this org's Prometheus, Alertmanager and healthcheck, no API mounted; independent of TLS_MODE
AGENT_API_ADDR=:8443
PLATFORM_ADDR=__vm-public-host__:8443         # agent join dial-back address; must be reachable from nodes/other hosts, use this VM's public IP/domain
# CROSS_ORG_ENABLED=true                       # optional: enable cross-org read-only access (access keys; Enterprise only). Off by default: no 8544 listener, no keys issued;
#                                              #   when on, 8544 must also be published in docker-compose.override.yml (see the "Cross-org" section of the README)
# CROSS_ORG_ADDR=:8544                         # optional: listen address for cross-org read-only access, default :8544;
#                                              #   the default address given to the other side in the key = PLATFORM_ADDR's host + this port. If changed, update the port mapping in the override too
PUBLIC_API_BASE=__vm-public-base__            # address nodes use to reach the platform over HTTP (installer download, --platform-http, log settings and RPC public key URLs); e.g. https://bsos-node-manager-1.example. Optional, filled in by up.sh; if unset, on-screen commands use the host of the incoming request (scheme and port follow the browser URL)

# ── TLS (terminated by the Go server itself since nginx was removed, see backend/internal/webapp) ── filled in by up.sh from --acme/--cert+--key/--http
TLS_MODE=http                                 # acme (public, automatic) | manual (manual certificate) | http (plain HTTP)
SITE_DOMAIN=                                  # required for acme (HostPolicy); optional for manual/http (used for the 80->443 redirect)
ACME_EMAIL=                                   # required for acme (Let's Encrypt account/expiry notices)
ACME_STAGING=false                            # optional for acme: true = use the LE staging CA to test the flow first (browsers do not trust the certificate)

# ── Frontend / security ──
# COOKIE_SECURE=true                          # optional: by default the sign-in cookie is Secure in acme/manual and not in http mode; set only when TLS_MODE=http runs behind a TLS terminator
#TRUSTED_PROXY_CIDR=10.0.0.5                  # set only when behind a forwarding proxy: X-Forwarded-For is trusted only for connections from these IPs/ranges (used to record source IPs in the audit log)

# ── Provisioning ──
LEAF_TTL=72h

# ── Real monitoring time series (Prometheus) ──
# PROMETHEUS_URL / SD_TOKEN_DIR are overridden by docker-compose.yml (pointing at the prometheus service / shared volume); not set here.
# SD_TOKEN: the bearer Prometheus uses for /sd/targets. up.sh generates it automatically; the server writes it to the shared volume for Prometheus and Alertmanager. If unset, /sd/targets is disabled.
SD_TOKEN=__up.sh generates this__
