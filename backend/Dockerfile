# Platform Server container image. Build context = repo root
# (the multi-stage build needs both backend/ and frontend/ sources; see deploy/platform/docker-compose/docker-compose.yml).
#
# EDITION: core (default, and the only one the open-source edition can build) or enterprise.
# Deploy scripts (up.sh) pass enterprise only when they detect backend/enterprise/.
#
# The platform is deployed only as a container. The server is built with cgo on a glibc base (UBI 9, same packages as RHEL 9):
# a future direct HSM integration has to load the vendor's PKCS#11 library, which only ships for glibc. The agent does not use
# this file; it stays a CGO_ENABLED=0 static binary that runs on any node host.
ARG EDITION=core

# Build stage 1: frontend dist, embedded into the binary by stage 2 via go:embed and served same-origin, replacing the nginx
# that used to sit in front (see backend/internal/webapp, deploy/platform/README.md).
FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS frontend
ARG EDITION
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Core drops the Enterprise frontend: src/edition.ts and others load it with import.meta.glob, which yields nothing when the directory is absent.
# (Go relies on build tags, so nothing is deleted there; the open-source edition has no such directories at all)
RUN case "$EDITION" in core) rm -rf src/enterprise;; enterprise) ;; *) echo "EDITION must be core or enterprise: $EDITION" >&2; exit 1;; esac \
 && npm run build

# Build stage 2: server binary (cgo, dynamically linked against glibc). install.sh and the frontend dist are embedded via go:embed.
# Build and runtime use the same UBI version so glibc matches; build cross-arch images with docker buildx --platform rather than setting GOARCH here (cgo cannot cross-compile directly).
FROM registry.access.redhat.com/ubi9/go-toolset:1.26@sha256:c2bd0309bf78ae317024fdfc5602a31704e0dba9572f6d4b0bd4b681033dc965 AS build
ARG EDITION
USER 0
# go-toolset defaults to GOTOOLCHAIN=local, so the build fails outright when it is older than the go directive in go.mod; its 1.26
# is currently 1.26.7, short of 1.26.10, which fixes intermediate-certificate blocking. In the meantime let go download the official
# toolchain per go.mod (the build needs access to proxy.golang.org); drop this line once Red Hat ships 1.26.10 or later.
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
COPY --from=frontend /app/dist ./internal/webapp/dist
# No file uses -tags core, so it is the same as no tag; only -tags enterprise compiles in cmd/server/edition_enterprise.go
# Version and release date come from up.sh (deploy/version.sh); a build without them reports dev
ARG VERSION=dev
ARG RELEASE_DATE=
RUN CGO_ENABLED=1 go build -tags "$EDITION" -trimpath \
    -ldflags="-s -w -X besu-manager/backend/internal/version.Version=${VERSION} -X besu-manager/backend/internal/version.ReleaseDate=${RELEASE_DATE}" \
    -o /out/server ./cmd/server
# Ship cactl (CA material: init-offline / import / rotate-intermediate / show) in the image so container deployments can run it
RUN CGO_ENABLED=1 go build -trimpath -ldflags='-s -w' -o /out/cactl ./cmd/cactl

# Runtime stage: UBI 9 minimal. ca-certificates (outbound TLS for OIDC), setcap and curl (healthcheck) are built in, so no extra packages; a shell is kept for on-site debugging.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:4b79c93106c14ad1c234907f83441ff0e4f8d24e78426a36e159098e9f7e6fa5
# With cgo enabled Go defaults to libc DNS resolution; keep the previous pure-Go resolver behavior
ENV GODEBUG=netdns=go
COPY --from=build /out/server /usr/local/bin/bsos-node-manager-server
COPY --from=build /out/cactl /usr/local/bin/cactl
# License and third-party notices ship with the image (Apache 2.0 section 4, each dependency's copyright notice); the list is generated by tools/deps/notices.py
COPY LICENSE NOTICE /usr/share/licenses/bsos-node-manager/
COPY third_party/ /usr/share/licenses/bsos-node-manager/third_party/

# Run as non-root. Binding 80/443 uses a file capability rather than changing ports:
# changing ports would ripple into the compose port mappings and the server.env generated by up.sh (and acme TLS-ALPN-01 is tied to
# public 443). Adding a capability that only grants binding low ports has a much smaller blast radius and needs no cap_add at the container level.
RUN setcap 'cap_net_bind_service=+ep' /usr/local/bin/bsos-node-manager-server \
 && useradd -M -u 10001 -s /sbin/nologin besu \
 # 65534 = nobody: the platform chgrps sd_token and alertmanager.yml to it so those two containers can read them.
 # A non-root process can only chgrp files to groups it belongs to, so join it here first (see os.Chown in internal/pki/sharedvolume.go).
 && usermod -aG nobody besu \
 # Volumes mounted by compose are owned by root when first created and a non-root process cannot write them; create them up front and hand them to the runtime user.
 && mkdir -p /acme-cache /sd-token /alertmanager-config /prom-rules-config \
 && chown besu:besu /acme-cache /sd-token /alertmanager-config /prom-rules-config

# 80/443 = website (frontend + Platform API, same-origin, see internal/webapp; plain-HTTP mode uses only 80) / 8443 = agent mTLS / 8544 = cross-org read-only (access keys; listens only on Enterprise with CROSS_ORG_ENABLED=true, not published by compose by default)
EXPOSE 80 443 8443 8544

USER besu

# The agent binary (downloaded in install.sh step 5) is provided by mounting AGENT_BINARY_DIR; DATABASE_URL/ORG_ID/CA_MASTER_KEY come from env.
ENTRYPOINT ["/usr/local/bin/bsos-node-manager-server"]
