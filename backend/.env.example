# Copy to .env and adjust for your environment (.env is not version-controlled)
LISTEN_ADDR=:8080
INTERNAL_ADDR=:8081   # internal listener (Prometheus / Alertmanager / healthcheck); also defaults to :8080, so move it for local dev
DATABASE_URL=postgres://besu:besu@localhost:5432/besu_manager
ORG_ID=org-a
PLATFORM_ADDR=localhost:8443
AGENT_API_ADDR=:8443
# Cross-org read-only: Enterprise edition only (Core ignores these). Not listening by default
# CROSS_ORG_ENABLED=true
# CROSS_ORG_ADDR=:8544
# Embedded CA master key (required; generate with: openssl rand -hex 32; never in version control or the DB)
CA_MASTER_KEY=
